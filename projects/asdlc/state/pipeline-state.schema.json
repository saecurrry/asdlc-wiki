        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "major",
            "minor",
            "info"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        },
        "owning_stage": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "superseded"
          ]
