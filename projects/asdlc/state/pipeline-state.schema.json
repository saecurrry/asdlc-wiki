        "integration_owner": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "initiative_id",
        "epic_id",
        "requirement_ids",
        "artifact_ref",
        "dependencies",
        "status",
        "resources",
        "eligibility",
        "integration_owner"
      ]
    },
    "sprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "story_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
