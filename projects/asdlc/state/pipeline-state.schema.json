        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "run_id",
        "author_actor",
        "reviewer_actor",
        "target_ref",
        "input_refs",
        "criteria_ref",
        "verdict",
