{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed ASDLC pipeline state, not runtime v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pipeline-design-1"
    },
    "project_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "illustrative_only": {
      "const": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "raid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raid"
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sprint"
      }
    },
    "code_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "illustrative_only",
    "artifacts",
    "stages",
    "runs",
    "questions",
    "decisions",
    "findings",
    "reviews",
    "approvals",
    "conditions",
    "raid",
    "stories",
    "sprints",
    "code_versions",
    "evidence",
    "next_actions",
    "policies"
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hash_kind": {
          "type": "string",
          "enum": [
            "file_bytes",
            "canonical_json"
          ]
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256",
        "hash_kind",
        "input_refs"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "ready",
            "running",
            "awaiting_input",
            "awaiting_review",
            "changes_requested",
            "awaiting_approval",
            "accepted",
            "blocked",
            "stale"
          ]
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_ref": {
          "type": "string"
        },
        "repair_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "status",
        "input_refs",
        "output_refs",
        "policy_ref",
        "repair_count"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "worker",
            "challenger"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "input_digest": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "dispatched",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria_ref": {
          "type": "string"
        },
        "policy_ref": {
          "type": "string"
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "stage_id",
        "actor",
        "role",
        "revision",
        "input_digest",
        "status",
        "scope",
        "output_refs",
        "input_refs",
        "criteria_ref",
        "policy_ref",
        "target_ref"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "required_stage": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "deferred"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "answer_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "deferral_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "stage_id",
        "text",
        "owner",
        "required_stage",
        "status",
        "answer",
        "answer_source",
        "deferral_reason"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "decided",
            "superseded"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "stage_id",
        "owner",
        "status",
        "options",
        "choice",
        "rationale",
        "source"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "review_id": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
