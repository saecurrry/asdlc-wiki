          ]
        }
      },
      "required": [
        "id",
        "code_ref",
        "artifact_refs",
        "command",
        "execution",
        "result",
        "output_ref"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "question",
            "prepare",
            "dispatch",
            "review",
            "approval",
            "escalation"
          ]
        },
