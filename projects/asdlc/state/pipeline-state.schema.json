        "id",
        "target_refs",
        "policy_ref",
        "actor",
        "source",
        "decision",
        "condition_ids",
        "status"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "due": {
          "type": "string"
